# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Component vars — used by docker-compose.yml to configure the postgres service
# and to construct the internal POSTGRES_URL for the api container.
POSTGRES_DB=sspm
POSTGRES_USER=sspm
POSTGRES_PASSWORD=change_me_strong_password

# Used when running the app directly (outside Docker); compose overrides this
# with the internal hostname automatically.
POSTGRES_URL=postgresql://sspm:change_me_strong_password@localhost:5432/sspm

# ── Neo4j ─────────────────────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me_strong_password

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Encryption ────────────────────────────────────────────────────────────────
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=generate_with_fernet

# ── GitHub connector ──────────────────────────────────────────────────────────
GITHUB_TOKEN=ghp_your_personal_access_token
GITHUB_ORG=your-org-name
# GITHUB_BASE_URL=https://github.yourcompany.com/api/v3  # GitHub Enterprise only

# ── DeepSeek LLM (optional) ───────────────────────────────────────────────────
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-chat

# ── Ollama LLM (local) ────────────────────────────────────────────────────────
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2
OLLAMA_ENABLED=true

# ── LLM timeouts ──────────────────────────────────────────────────────────────
LLM_TIMEOUT_OLLAMA=60
LLM_TIMEOUT_DEEPSEEK=30
LLM_FALLBACK_TO_TEMPLATE=true

# ── API server ────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json

# ── Deployment ────────────────────────────────────────────────────────────────
# Your GitHub repository in "username/repo" format — used as the Docker image
# name in docker-compose.yml: ghcr.io/${GITHUB_REPOSITORY}:latest
GITHUB_REPOSITORY=your-username/sspm
